datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrganizationAccessStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationCommercialStatus {
  DEMO
  PILOT
  ACTIVE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum BusinessScopeStatus {
  ACTIVE
  INACTIVE
}

enum BusinessScopeType {
  RESTAURANT
  PROPERTY_DEVELOPMENT
  CONSTRUCTION
  EVENT
}

model Organization {
  id               String                       @id @default(uuid())
  name             String
  accessStatus     OrganizationAccessStatus     @map("access_status")
  commercialStatus OrganizationCommercialStatus @map("commercial_status")
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  companies     Company[]
  scopes        BusinessScope[]
  evidence      Evidence[]
  emailOutboxes EmailOutbox[]
  invitations   OrganizationInvitation[]
  members       OrganizationMember[]

  @@map("organization")
}

model Identity {
  id              String   @id @default(uuid())
  email           String   @unique
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  createdAt       DateTime @default(now()) @map("created_at")

  passwordCredential PasswordCredential?
  sessions           Session[]
  resetTokens        PasswordResetToken[]
  memberships        OrganizationMember[]
  createdScopes      BusinessScope[]

  @@map("identity")
}

model PasswordCredential {
  id           String @id @default(uuid())
  identityId   String @unique @map("identity_id")
  passwordHash String @map("password_hash")

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("password_credential")
}

model Session {
  id         String   @id // hashed session id
  identityId String   @map("identity_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("session")
}

model PasswordResetToken {
  id         String   @id // hashed token
  identityId String   @map("identity_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("password_reset_token")
}

model Company {
  id             String
  organizationId String        @map("organization_id")
  name           String
  status         CompanyStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scopes       BusinessScope[]

  @@id([organizationId, id])
  @@map("company")
}

model BusinessScope {
  id                String
  organizationId    String              @map("organization_id")
  companyId         String              @map("company_id")
  type              BusinessScopeType
  name              String
  externalId        String              @default("") @map("external_id")
  location          String?
  responsiblePerson String?             @map("responsible_person")
  createdById       String              @map("created_by_id")
  status            BusinessScopeStatus @default(ACTIVE)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  company      Company      @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Identity     @relation(fields: [createdById], references: [id])

  @@id([organizationId, id])
  @@unique([companyId, type, name, externalId])
  @@map("business_scope")
}

model EmailOutbox {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  payload        String
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("email_outbox")
}

model Evidence {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorId        String   @map("actor_id")
  action         String
  reason         String?
  before         Json?
  after          Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("evidence")
}

model OrganizationInvitation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String
  tokenHash      String    @unique @map("token_hash")
  role           String?
  grants         Json?
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("organization_invitation")
}

enum OrganizationMemberStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

model OrganizationMember {
  id             String                   @id @default(uuid())
  organizationId String                   @map("organization_id")
  identityId     String                   @map("identity_id")
  status         OrganizationMemberStatus @default(ACTIVE)
  role           String
  grants         Json?
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity     Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, identityId])
  @@map("organization_member")
}
