# ==========================================
# NOVA API - Environment Variables
# ==========================================

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# The default local setup uses the 'postgres' superuser.
# The application automatically drops privileges to 'nova_app' securely for tenant isolation.
DATABASE_URL="postgresql://postgres:password@localhost:5432/nova?schema=public"

# ------------------------------------------
# Email Service (Resend)
# ------------------------------------------
# Required for sending real emails. 
# Leave dummy values for testing logic without sending actual emails.
RESEND_API_KEY="your_resend_api_key_here"
EMAIL_SENDER="noreply@nova.test"

# ------------------------------------------
# Initial System Administrator
# ------------------------------------------
# The credentials used to seed the initial Platform Administrator account.
ADMIN_EMAIL="admin@nova.test"
ADMIN_PASSWORD="ThisIsAMockPassword123"
