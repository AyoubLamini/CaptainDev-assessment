+
+  private checkRecentAuthentication(req: Request) {
+    const session = req.session;
+    if (!session) {
+      throw new UnauthorizedException('Recent re-authentication required');
+    }
+
+    const ageInMinutes = (new Date().getTime() - session.createdAt.getTime()) / 60000;
+    if (ageInMinutes > 15) {
+      throw new UnauthorizedException('Recent re-authentication required');
+    }
+  }
+
+  @Post(':id/terminal-disablement')
+  @HttpCode(200)
+  async terminallyDisable(
+    @Param('id') id: string,
+    @Body() dto: TerminalDisablementDto,
+    @Req() req: Request,
+  ) {
+    this.checkRecentAuthentication(req);
+    const actorId = req.identity?.id as string;
+    return this.service.terminallyDisableOrganization(id, dto.reason, actorId);
+  }
+
+  @Post(':id/interventions/remove-member')
+  @HttpCode(200)
+  async removeMemberIntervention(
+    @Param('id') id: string,
+    @Body() dto: RemoveMemberInterventionDto,
+    @Req() req: Request,
+  ) {
+    this.checkRecentAuthentication(req);
+    const actorId = req.identity?.id as string;
+    return this.service.removeMemberIntervention(id, dto.identityId, dto.reason, actorId);
+  }
 }
