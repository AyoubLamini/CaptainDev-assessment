+
+  async terminallyDisableOrganization(orgId: string, reason: string, actorId: string) {
+    return this.prisma.$transaction(async (tx) => {
+      const org = await tx.organization.findUnique({
+        where: { id: orgId },
+      });
+
+      if (!org) {
+        throw new NotFoundException('Organization not found');
+      }
+
+      if (org.accessStatus === OrganizationAccessStatus.DISABLED) {
+        throw new ConflictException('Organization is already disabled');
+      }
+
+      await tx.organization.update({
+        where: { id: orgId },
+        data: { accessStatus: OrganizationAccessStatus.DISABLED },
+      });
+
+      // Revoke sessions for all members of the organization
+      await tx.session.deleteMany({
+        where: {
+          identity: {
+            organizationMembers: {
+              some: {
+                organizationId: orgId,
+              },
+            },
+          },
+        },
+      });
+
+      await tx.evidence.create({
+        data: {
+          organizationId: orgId,
+          actorId,
+          action: EvidenceActions.TERMINAL_DISABLEMENT,
+          reason,
+          before: { accessStatus: org.accessStatus },
+          after: { accessStatus: OrganizationAccessStatus.DISABLED },
+        },
+      });
+
+      return { success: true };
+    });
+  }
+
+  async removeMemberIntervention(orgId: string, targetIdentityId: string, reason: string, actorId: string) {
+    return this.prisma.$transaction(async (tx) => {
+      const org = await tx.organization.findUnique({
+        where: { id: orgId },
+      });
+
+      if (!org) {
+        throw new NotFoundException('Organization not found');
+      }
+
+      const member = await tx.organizationMember.findUnique({
+        where: {
+          organizationId_identityId: {
+            organizationId: orgId,
+            identityId: targetIdentityId,
+          },
+        },
+      });
+
+      if (!member) {
+        throw new NotFoundException('Member not found in the organization');
+      }
+
+      if (member.role === 'OWNER') {
+        const ownerCount = await tx.organizationMember.count({
+          where: {
+            organizationId: orgId,
+            role: 'OWNER',
+          },
+        });
+
+        if (ownerCount <= 1) {
+          throw new ConflictException('Cannot remove the last owner');
+        }
+      }
+
+      await tx.organizationMember.delete({
+        where: {
+          organizationId_identityId: {
+            organizationId: orgId,
+            identityId: targetIdentityId,
+          },
+        },
+      });
+
+      await tx.session.deleteMany({
+        where: { identityId: targetIdentityId },
+      });
+
+      await tx.evidence.create({
+        data: {
+          organizationId: orgId,
+          actorId,
+          action: EvidenceActions.REMOVE_MEMBER_INTERVENTION,
+          reason,
+          before: { targetIdentityId, role: member.role },
+          after: Prisma.JsonNull,
+        },
+      });
+
+      return { success: true };
+    });
+  }
 }
 
